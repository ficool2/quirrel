//-----------------------------------------------------------------------------
//	QUIRREL.VPC
//-----------------------------------------------------------------------------

$Macro SRCDIR		"..\.."
$Macro QUIRRELDIR	"$SRCDIR\thirdparty\quirrel"

$Conditional DISABLE_RTTI		"true"
$Conditional THIRDPARTYPROJECT	"true"

$include "$SRCDIR\vpc_scripts\source_lib_base.vpc"

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories	"$BASE;$QUIRRELDIR\;$QUIRRELDIR\include;$QUIRRELDIR\internal;$QUIRRELDIR\helpers;$QUIRRELDIR\squirrel;$QUIRRELDIR\squirrel\compiler;$QUIRRELDIR\sqmodules;$QUIRRELDIR\sqrat\include"

		// not needed for now
		$PreprocessorDefinitions		"$BASE;SQ_VAR_TRACE_ENABLED=0"
		
		$PreprocessorDefinitions		"$BASE;_CRT_SECURE_NO_WARNINGS"

		// TODO see if we can get rid of this
		$EnableC++Exceptions			"Yes (/EHsc)"

		$AdditionalOptions				"$BASE -Wno-unused-parameter -Wno-missing-braces -Wno-missing-field-initializers -Wno-deprecated-copy-with-user-provided-copy -Wno-trigraphs" [$CLANG_CL]
	}
}

